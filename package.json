{
  "name": "dsh-auto-click",
  "version": "0.1.0",
  "type": "module",
  "description": "左侧栏中选择文件的方式：单击在侧边栏打开、Ctrl+单击用系统默认应用打开、右键弹出完整的文件菜单。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "file-menu",
    "context-menu",
    "sidebar"
  ],
  "license": "MIT",
  "author": "Analoty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Analoty/dsh-auto-click.git"
  },
  "bugs": {
    "url": "https://github.com/Analoty/dsh-auto-click/issues"
  },
  "homepage": "https://github.com/Analoty/dsh-auto-click#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}